# ── ZenTrack AI Assistant – Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore – never commit real secrets.

# Required: Your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: Override the default model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o
